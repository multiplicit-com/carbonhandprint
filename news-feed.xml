---
layout: null
permalink: /news/feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en-GB">
  <title>{{ site.title }}: News</title>
  <subtitle>Climate and carbon handprint news, linking straight to the source.</subtitle>
  <link href="{{ '/news/feed.xml' | absolute_url }}" rel="self"/>
  <link href="{{ '/news/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/news/' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.data.authors.editors.name }}</name></author>
{% assign items = site.news | sort: "date" | reverse %}{% for n in items limit: 30 %}  <entry>
    <title>{% if n.snippet %}In brief: {% endif %}{{ n.title | xml_escape }}</title>
    <link href="{{ n.link | xml_escape }}" rel="alternate"/>
    <id>{{ '/news/' | absolute_url }}#{{ n.slug }}</id>
    <published>{{ n.date | date_to_xmlschema }}</published>
    <updated>{{ n.date | date_to_xmlschema }}</updated>
    <summary>{{ n.description | xml_escape }}{% if n.source %} ({{ n.source | xml_escape }}){% endif %}</summary>
  </entry>
{% endfor %}</feed>
