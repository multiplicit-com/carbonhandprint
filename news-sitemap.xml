---
layout: null
permalink: /news-sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
{% assign cutoff = site.time | date: "%s" | minus: 172800 %}{% for post in site.posts %}{% assign t = post.date | date: "%s" | plus: 0 %}{% if t >= cutoff %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <news:news>
      <news:publication><news:name>{{ site.title }}</news:name><news:language>en</news:language></news:publication>
      <news:publication_date>{{ post.date | date_to_xmlschema }}</news:publication_date>
      <news:title>{{ post.title | xml_escape }}</news:title>
    </news:news>
  </url>{% endif %}{% endfor %}
</urlset>
